# Copy to .env for local `npm start`. Do not commit real addresses.
# On Render: Dashboard → web service → Environment → add these, then save.

# Optional. Public contact used only for the Ask mailto fallback if POST fails.
# If unset, the form still posts to /api/ask (Render logs).
# Do not hardcode a personal address in the repo.
ASK_NOTIFY_EMAIL=

# Optional. JSONL path if you attach a Render disk. Leave blank to log to
# stdout only on Render (the filesystem is ephemeral).
ASK_LOG_PATH=
